# Required for the frontend build (set these in Vercel Project Settings > Environment Variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: platform credentials (Meta, LinkedIn, app URL) can instead be set at
# runtime from Settings > Integrations in the app itself (stored in Supabase),
# which takes priority over these. Set them here / as Supabase Edge Function
# secrets only if you want them pre-configured before first login.
# META_APP_ID=
# META_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# APP_URL=https://your-app.vercel.app
